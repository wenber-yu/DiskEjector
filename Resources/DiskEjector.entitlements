<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mac App Store 强制要求。开启后进程受沙盒约束，实测影响如下（本机验证）：
         - 卷枚举 mountedVolumeURLs：可用
         - NSWorkspace.unmountAndEjectDevice：可用（核心功能得以保留）
         - lsof / proc_listallpids / kill()：不可用（故占用进程检测降级为 .unknown）
    -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- 按最小权限原则，本应用不申请任何额外权限：
         - 不读取卷内文件内容，只需要卷的挂载路径与容量，因此不需要文件访问类权限
         - 不直接与 USB 设备通信（推出经由 NSWorkspace 请求系统服务），因此不需要
           com.apple.security.device.usb
         - 无网络访问需求
    -->
</dict>
</plist>
