    "diskInUseMessage" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "以下程序正在访问磁盘 \"%@\"：\n\n%@\n\n直接推出可能导致数据丢失（这些程序中未保存的工作将被丢弃）。是否终止这些程序并推出磁盘？" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The following programs are accessing disk \"%@\":\n\n%@\n\nEjecting directly may cause data loss (unsaved work in these programs will be discarded). Terminate these programs and eject the disk?" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "以下程式正在存取磁碟 \"%@\"：\n\n%@\n\n直接退出可能導致資料遺失（這些程式中未儲存的工作將被丟棄）。是否終止這些程式並退出磁碟？" } }
      }
    },
