    "ejectFailedInUseReason" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "磁盘 \"%@\" 正被其他程序使用。请关闭可能正在访问它的程序后重试。" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The disk \"%@\" is in use. Quit any apps that might be using it, then try again." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "磁碟 \"%@\" 正被其他程式使用中。請關閉可能正在存取它的程式後再試一次。" } }
      }
    },
    "ejectDiskFormat" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "推出 %@" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Eject %@" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "退出 %@" } }
      }
    },
