    "insertDiskHint" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请插入移动硬盘或U盘" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Insert an external drive or USB disk" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "請插入外接硬碟或隨身碟" } }
      }
    },
    "launchAtLogin" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开机启动" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Launch at Login" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開機啟動" } }
      }
    },
    "launchAtLoginErrorMessage" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请将磁盘推出助手移到「应用程序」文件夹后重试。" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Move DiskEjector to the Applications folder and try again." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "請將磁碟推出助手移到「應用程式」檔案夾後重試。" } }
      }
    },
    "launchAtLoginNeedsApprovalTitle" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "需要在系统设置中允许" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Approval Needed in System Settings" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "需要在系統設定中允許" } }
      }
    },
    "launchAtLoginNeedsApprovalMessage" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "macOS 要求手动允许登录项。请前往「系统设置 → 通用 → 登录项」，开启磁盘推出助手的开关。" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "macOS requires manual approval for login items. Go to System Settings \u2192 General \u2192 Login Items and enable DiskEjector." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "macOS 要求手動允許登入項目。請前往「系統設定 \u2192 一般 \u2192 登入項目」，開啟磁碟推出助手的開關。" } }
      }
    },
    "launchAtLoginUnavailableMessage" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前无法设置登录项。请将磁盘推出助手移到「应用程序」文件夹后重试。" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Login items are unavailable. Move DiskEjector to the Applications folder and try again." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前無法設定登入項目。請將磁碟推出助手移到「應用程式」檔案夾後再試一次。" } }
      }
    },
    "openSystemSettings" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开系统设置" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Open System Settings" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "打開系統設定" } }
      }
    },
    "launchAtLoginErrorTitle" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法设置开机启动" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Unable to Set Launch at Login" } },
