      }
    },
    "launchAtLoginFootnote" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "登录 macOS 后自动在菜单栏启动磁盘推出助手" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Starts DiskEjector in the menu bar after you log in to macOS" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "登入 macOS 後自動在選單列啟動磁碟推出助手" } }
