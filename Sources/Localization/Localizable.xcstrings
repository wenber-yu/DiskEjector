      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法推出磁盘 \"%@\": %@" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Failed to eject the disk \"%@\": %@" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法退出磁碟 \"%@\": %@" } }
      }
    },
    "ejectBusyTitle" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "即将推出 %@" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Ejecting %@" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "即將退出 %@" } }
      }
    },
    "ejectBusyMessageFormat" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "以下程序正在访问此磁盘。关闭它们可能导致未保存的数据丢失：" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The following apps are accessing this disk. Quitting them may lose unsaved work:" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "以下程式正在存取此磁碟。關閉它們可能導致未儲存的資料遺失：" } }
      }
    },
    "ejectBusyNoProcessInfo" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "磁盘「%@」正被占用，但当前无法列出具体程序。请确认已在「系统设置 › 隐私与安全性 › 完全磁盘访问」中允许磁盘推出助手后重试。" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The disk \"%@\" is in use, but the specific apps cannot be listed. Make sure DiskEjector is granted Full Disk Access in System Settings › Privacy & Security, then try again." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "磁碟「%@」正被佔用，但目前無法列出具體程式。請確認已在「系統設定 › 隱私與安全性 › 完全磁碟存取」中允許磁碟推出助手後再試。" } }
      }
    },
    "ejectBusyWarning" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "警告：关闭这些程序将导致其中未保存的内容丢失。请先保存好工作，再确认是否关闭并推出。" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Warning: Quitting these apps will lose any unsaved work in them. Save your work before confirming." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "警告：關閉這些程式將導致其中未儲存的內容遺失。請先儲存工作，再確認是否關閉並退出。" } }
      }
    },
    "closeAndEject" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭并推出" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Close & Eject" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "關閉並退出" } }
