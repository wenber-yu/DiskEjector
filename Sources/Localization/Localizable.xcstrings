      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "确定要推出此磁盘吗？" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Are you sure you want to eject this disk?" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "確定要退出此磁碟嗎？" } }
      }
