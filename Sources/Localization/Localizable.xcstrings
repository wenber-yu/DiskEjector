    "occupancyUnknownHint" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前环境无法检测占用进程" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Unable to detect which apps are using this disk in the current environment" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前環境無法偵測佔用程式" } }
      }
    },
    "occupancyNeedsFullDiskAccessHint" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未能检测到占用程序。若确有程序正在使用此磁盘，请在「系统设置 › 隐私与安全性 › 完全磁盘访问」中允许磁盘推出助手。" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not detect which apps are using this disk. If an app is using it, grant DiskEjector Full Disk Access in System Settings › Privacy & Security." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "未能偵測佔用程式。若確有程式正在使用此磁碟，請在「系統設定 › 隱私與安全性 › 完全磁碟存取」中允許磁碟推出助手。" } }
      }
    },
    "fdaGuidanceBanner" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未授予「完全磁盘访问」，无法显示占用进程。请前往系统设置 › 隐私与安全性 › 完全磁盘访问 中允许磁盘推出助手。" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Full Disk Access is not granted, so occupying processes can't be shown. Allow DiskEjector in System Settings › Privacy & Security › Full Disk Access." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "尚未授予「完全磁碟存取」，無法顯示佔用程式。請前往系統設定 › 隱私與安全性 › 完全磁碟存取 中允許磁碟推出助手。" } }
      }
    },
    "fdaGuidanceBannerLead" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未授予「完全磁盘访问」，无法显示占用进程" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Full Disk Access is not granted, so occupying processes can't be shown" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "尚未授予「完全磁碟存取」，無法顯示佔用程式" } }
      }
    },
    "fdaGuidanceBannerTail" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请前往系统设置 › 隐私与安全性 › 完全磁盘访问 中允许磁盘推出助手。" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow DiskEjector in System Settings › Privacy & Security › Full Disk Access." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "請前往系統設定 › 隱私與安全性 › 完全磁碟存取 中允許磁碟推出助手。" } }
      }
    },
    "fdaOnboardingTitle" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "需要完全磁盘访问权限" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Full Disk Access required" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "需要完全磁碟存取權限" } }
      }
    },
    "fdaOnboardingBody" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "为检测占用磁盘的外部进程，磁盘推出助手需要「完全磁盘访问」权限。授权后应用即可列出正在读写磁盘的应用程序，帮助您安全推出。" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "To detect other processes using this disk, DiskEjector needs Full Disk Access. Once granted, the app can list which apps are reading or writing to the disk and help you eject safely." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "為偵測佔用磁碟的外部程式，磁碟推出助手需要「完全磁碟存取」權限。授權後應用即可列出正在讀寫磁碟的應用程式，協助您安全退出。" } }
      }
    },
    "fdaRepromptBody" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "我们刚刚无法检测到占用此磁盘的程序。这正是因为尚未授予「完全磁盘访问」权限——磁盘推出助手需要它才能读取其他进程。\\n\\n请：\\n1. 点击下方「打开系统设置」\\n2. 在「隐私与安全性 › 完全磁盘访问」中找到磁盘推出助手并打开开关\\n3. 重启磁盘推出助手（或重新插入磁盘）" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "We just couldn't detect which app is using this disk. That's because Full Disk Access hasn't been granted yet — DiskEjector needs it to read other processes.\\n\\nPlease:\\n1. Click Open System Settings below\\n2. In Privacy & Security › Full Disk Access, find DiskEjector and turn it on\\n3. Restart DiskEjector (or re-plug the disk)" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "我們剛剛無法偵測到佔用此磁碟的程式。這正是因為尚未授予「完全磁碟存取」權限——磁碟推出助手需要它才能讀取其他程序。\\n\\n請：\\n1. 點擊下方「打開系統設定」\\n2. 在「隱私與安全性 › 完全磁碟存取」中找到磁碟推出助手並開啟開關\\n3. 重新啟動磁碟推出助手（或重新插入磁碟）" } }
      }
    },
    "notNow" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "稍后" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Later" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "稍後" } }
      }
    },
    "occupiedProcessesMessage" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "以下程序正在访问此磁盘，关闭它们可能导致数据丢失（未保存的工作将被丢弃）：\n\n%@\n" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The following programs are accessing this disk. Closing them may cause data loss (unsaved work will be discarded):\n\n%@\n" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "以下程式正在存取此磁碟，關閉它們可能導致資料遺失（未儲存的工作將被丟棄）：\n\n%@\n" } }
      }
