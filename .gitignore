# ---- 构建产物 ----
dist/
.build/
/Packages
SPMPackages/

# 覆盖率运行会把 profraw 落到「当前工作目录」（不是 .build/ 里）——
# `swift test --enable-code-coverage` 之后直接跑一次二进制就会在仓库根留下它。
default.profraw

# `tools/clt_swift_env.sh` 在「Xcode 许可未接受」时会往**包根**放一个指向 Xcode
# `xcstringstool` 的软链：CLT 没有这个工具，而 SwiftPM 找不到它时按**包根**回落
# （不是调用目录，也不看 PATH —— 见该脚本注释）。只锚定包根，不匹配子目录同名文件。
/xcstringstool

# ---- Xcode / SPM 本地状态 ----
xcuserdata/
DerivedData/
.swiftpm/
.swiftpm/configuration/registries.json
.swiftpm/xcode/package.xcworkspace/contents.xcworkspacedata
.netrc

# ---- 设计工具运行时产物 ----
# solo-design 生成的调度清单与会话摘要，内含本机绝对路径（/Users/...），
# 属工具元数据而非设计交付物；设计本身见 pages/*.html 与 colors_and_type.css。
DiskEjector-UI-Design/runtime-*.json

# ---- macOS ----
.DS_Store

# ---- 本地工作记忆（本项目会话日志与长期笔记，不入库）----
.workbuddy/
# 新一代记忆目录（与 .workbuddy/ 并存，同样不入库）
.workbuddy-ai/
